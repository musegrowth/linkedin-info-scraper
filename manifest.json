{
  "manifest_version": 3,
  "name": "LinkedIn Inbox Profile Collector",
  "version": "1.0.0",
  "description": "Personal tool: slowly collects the visible profile details of people in your own LinkedIn inbox. Exports CSV.",
  "permissions": ["storage", "alarms", "downloads", "unlimitedStorage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Inbox Profile Collector"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
